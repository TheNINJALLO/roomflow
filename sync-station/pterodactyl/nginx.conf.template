pid /home/container/data/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 256; }

http {
  access_log off;
  client_body_temp_path /home/container/data/nginx/client_body;
  proxy_temp_path /home/container/data/nginx/proxy;

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  server {
    listen 0.0.0.0:{{SERVER_PORT}};
    server_name _;

    location = /health {
      proxy_pass http://127.0.0.1:8787/health;
      proxy_set_header Host $host;
      add_header Cache-Control "no-store" always;
    }

    location / {
      auth_basic "RoomFlow Sync Station";
      auth_basic_user_file /home/container/data/novnc.htpasswd;
      proxy_pass http://127.0.0.1:6080;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
    }
  }
}
